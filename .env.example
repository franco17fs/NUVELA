# =============================================================================
# NUVELA — variables de entorno
# Copiá este archivo a .env y completá los valores. NUNCA commitees .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://nuvela:nuvela@localhost:5432/nuvela?schema=public"

# -----------------------------------------------------------------------------
# Cifrado de tokens en reposo
# Clave de 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si esta clave se pierde, hay que reconectar las cuentas (los tokens no se
# pueden descifrar). Si esta clave se filtra, rotala y reconectá las cuentas.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Mercado Libre — aplicación OAuth
# Se crea en https://developers.mercadolibre.com.ar/devcenter
# El redirect_uri debe coincidir EXACTAMENTE con el registrado en la app.
# -----------------------------------------------------------------------------
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3000/api/oauth/mercadolibre/callback"
# Dominio de autorización por site. Argentina: auth.mercadolibre.com.ar
ML_AUTH_DOMAIN="auth.mercadolibre.com.ar"
ML_SITE_ID="MLA"

# Secreto que viaja en la URL del webhook para que solo Mercado Libre (y quien
# tenga este valor) pueda postear notificaciones:
#   https://tu-dominio/api/webhooks/mercadolibre/<ML_WEBHOOK_SECRET>
ML_WEBHOOK_SECRET=""

# Allowlist OPCIONAL de IPs de origen de las notificaciones (separadas por coma).
# Ver docs/mercadolibre-api-research.md §8.3: la lista puede cambiar sin aviso,
# por eso es un control adicional y no el único. Dejar vacío para desactivarlo.
ML_WEBHOOK_ALLOWED_IPS=""

# Límite de requests por minuto por cuenta contra la API de Mercado Libre.
# La documentación oficial NO publica un RPM general (ver research §9);
# arrancamos conservador y se calibra con los 429 registrados en SyncJob.
ML_RATE_LIMIT_RPM="60"

# -----------------------------------------------------------------------------
# Mercado Pago — credenciales propias (independientes de las de Mercado Libre)
# -----------------------------------------------------------------------------
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_REDIRECT_URI="http://localhost:3000/api/oauth/mercadopago/callback"
MP_RATE_LIMIT_RPM="60"

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
# Zona horaria de corte del negocio (día, quincena, mes).
APP_TIMEZONE="America/Argentina/Buenos_Aires"
# Token para invocar los endpoints de sincronización desde un cron externo:
#   curl -H "Authorization: Bearer $CRON_SECRET" $APP_BASE_URL/api/jobs/sync
CRON_SECRET=""

# Directorio donde se guardan los reportes descargados de Mercado Pago.
REPORTS_STORAGE_DIR="./storage/reports"
